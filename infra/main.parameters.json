{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "workloadName": {
      "value": "${FACTORY_WORKLOAD_NAME=demofactory}"
    },
    "workloadShort": {
      "value": "${FACTORY_WORKLOAD_SHORT=df}"
    },
    "environmentType": {
      "value": "${FACTORY_ENVIRONMENT_TYPE=dev}"
    },
    "instanceNumber": {
      "value": "${FACTORY_INSTANCE_NUMBER=001}"
    },
    "deploymentProfile": {
      "value": "${FACTORY_DEPLOYMENT_PROFILE=lean}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalName": {
      "value": "${AZURE_PRINCIPAL_NAME}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "ownerLogin": {
      "value": "${FACTORY_OWNER_LOGIN=azureholic}"
    },
    "factoryAppSlug": {
      "value": "${FACTORY_APP_SLUG=azureholic-demo-factory}"
    },
    "githubAppId": {
      "value": "${GITHUB_APP_ID=5758548}"
    },
    "vnetAddressPrefix": {
      "value": "${FACTORY_VNET_PREFIX=10.200.0.0/16}"
    }
  }
}
